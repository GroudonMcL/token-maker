{
  "name": "token-maker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "frame-sheet": "tsx scripts/frame-sheet.ts",
    "effect-sheet": "tsx scripts/effect-sheet.ts",
    "pages:dev": "npm run build && npx --yes wrangler@4 pages dev dist --port 8788 --compatibility-date=2026-09-01",
    "help-images": "tsx scripts/help-images.ts",
    "make-fixture": "tsx scripts/make-fixture.ts",
    "make-backgrounds": "tsx scripts/make-backgrounds.ts",
    "make-frames": "tsx scripts/make-frames.ts",
    "decoration-sheet": "tsx scripts/decoration-sheet.ts",
    "label-sheet": "tsx scripts/label-sheet.ts"
  },
  "dependencies": {
    "@fontsource/alegreya-sc": "^5.3.0",
    "@fontsource/almendra": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/cinzel-decorative": "^5.3.0",
    "@fontsource/eagle-lake": "^5.3.0",
    "@fontsource/germania-one": "^5.3.0",
    "@fontsource/grenze": "^5.3.0",
    "@fontsource/grenze-gotisch": "^5.3.0",
    "@fontsource/im-fell-english": "^5.3.0",
    "@fontsource/macondo": "^5.3.0",
    "@fontsource/medievalsharp": "^5.3.0",
    "@fontsource/metamorphous": "^5.3.0",
    "@fontsource/pirata-one": "^5.3.0",
    "@fontsource/spectral": "^5.3.0",
    "@fontsource/uncial-antiqua": "^5.3.0",
    "@fontsource/unifrakturmaguntia": "^5.3.0",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261022.1",
    "@eslint/js": "^9.39.5",
    "@napi-rs/canvas": "^1.0.13",
    "@playwright/test": "1.56.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.13.0",
    "jsdom": "^27.4.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
